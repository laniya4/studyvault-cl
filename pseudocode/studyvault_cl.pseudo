############################################################
# SECTION 20
# ADVANCED ANALYTICS
############################################################

FUNCTION identify_weakest_subject()

    GET all subjects


    FOR EACH subject

        CALCULATE average quiz score

        CALCULATE flashcard failure rate

        CALCULATE recent study time


        CREATE weakness score based on:

            low quiz scores

            high flashcard failure rate

            low recent study time

    END FOR


    SORT subjects by weakness score


    RETURN subject with highest weakness score

END FUNCTION



############################################################
# DIFFICULT FLASHCARD DETECTION
############################################################

FUNCTION identify_difficult_flashcards()

    GET flashcard review history


    FOR EACH flashcard

        COUNT number of Again ratings

        COUNT number of Hard ratings

        COUNT total reviews


        CALCULATE difficulty percentage


        IF difficulty percentage
           is above chosen threshold THEN

            ADD flashcard to difficult_cards list

        END IF

    END FOR


    SORT difficult cards
    from most difficult
    to least difficult


    RETURN difficult_cards

END FUNCTION



############################################################
# SECTION 21
# WEEKLY REPORT
############################################################

FUNCTION weekly_report()

    GET study sessions
    from last seven days


    CALCULATE:

        total study minutes

        total study sessions

        most studied subject

        least studied subject

        quizzes completed

        average quiz score

        flashcards reviewed

        goals completed


    DISPLAY ""
    DISPLAY "YOUR WEEK IN STUDYVAULT"

    DISPLAY results


    IF study time increased
       compared with previous week THEN

        DISPLAY:
            "Your study time increased this week."

    ELSE IF study time decreased THEN

        DISPLAY:
            "Your study time decreased this week."

    END IF

END FUNCTION



############################################################
# SECTION 22
# PROGRAM EXIT
############################################################

FUNCTION exit_program()

    SAVE all unsaved information

    CLOSE database connection

    DISPLAY ""
    DISPLAY "StudyVault saved successfully."

    DISPLAY "See you next time!"

    STOP PROGRAM

END FUNCTION